# FloChat environment template (Phase 01).
#
# Copy to `.env` (git-ignored) only if you need non-default settings, or export
# the same names in your shell. This file must never contain real secrets:
# paths only, never secret values.
#
# Windows PowerShell:  Copy-Item .env.example .env
# Termux/Linux/macOS:  cp .env.example .env

# Operating mode: manual (default) or persistent.
FLOCHAT_MODE=manual

# Log level: debug, info, warning, error.
FLOCHAT_LOG_LEVEL=info

# Directory for the local SQLite database and any session material.
# Default: %APPDATA%\FloChat (Windows), ~/Library/Application Support/FloChat (macOS),
#          $XDG_CONFIG_HOME/flochat or ~/.config/flochat (Linux/Android).
# FLOCHAT_HOME=

# Optional explicit path overrides.
# FLOCHAT_DB=
# OAuth: absolute Desktop client JSON path OUTSIDE the clone, never the secret value.
# FLOCHAT_CLIENT_SECRET=
# FLOCHAT_TOKEN_FILE is a legacy option. Leave unset: tokens use OS keyring only.

# Safety defaults.
# FLOCHAT_COOLDOWN_SECONDS=30
# FLOCHAT_MAX_COMMENT_LENGTH=200

# This template/.env is not auto-loaded. Export variables in your shell explicitly.
